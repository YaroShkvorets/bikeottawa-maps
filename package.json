{
  "name": "bikeottawa-maps",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "web",
    "pipeline"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck -w web",
    "lint": "biome check",
    "format": "biome check --write",
    "tiles": "pipeline/build-overlays.sh",
    "basemap": "pipeline/build-basemap.sh",
    "router": "docker run --rm -p 17777:17777 -v \"$PWD/routing/profiles/ottbike.brf:/profiles2/ottbike.brf:ro\" -v \"$PWD/routing/profiles/ottwalk.brf:/profiles2/ottwalk.brf:ro\" bikeottawa-router",
    "router:build": "routing/prepare-data.sh && docker build -t bikeottawa-router routing",
    "collisions": "node pipeline/fetch-collisions.mjs",
    "osm": "pipeline/update-osm.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6"
  }
}
